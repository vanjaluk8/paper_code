\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces PRISMA 2020 flow diagram. Records trace from \textbf  {1,150} raw snowball candidates through deduplication (\textbf  {972}), merge of the \textbf  {162} screened-in records with the pre-validated corpus and title screening (\textbf  {502}), enrichment (\textbf  {464}), and abstract review; the abstract-review pool (\textbf  {552}) combines the 464 enriched records with 88 forward-snowball additions and splits into \textbf  {214} KEEP, \textbf  {173} DEFER, and \textbf  {165} excluded (SKIP, no individually coded reason retained). The valid pool proceeds to full-text queue selection (\textbf  {387}), of which \textbf  {190} reach data extraction; a separate \textbf  {34}-record manual Scopus/WoS cross-validation top-up enters directly at the extraction stage, giving \textbf  {224} records extracted in total and yielding the \textbf  {123}-paper final reading list (\textbf  {120} distinct papers). The \textbf  {101} eligibility-stage exclusions are: \textbf  {34} manual cross-validation top-up, \textbf  {53} background-corpus, and \textbf  {14} core-corpus.}}{12}{figure.caption.9}\protected@file@percent }
\newlabel{fig:prisma}{{5}{12}{PRISMA 2020 flow diagram. Records trace from \textbf {1,150} raw snowball candidates through deduplication (\textbf {972}), merge of the \textbf {162} screened-in records with the pre-validated corpus and title screening (\textbf {502}), enrichment (\textbf {464}), and abstract review; the abstract-review pool (\textbf {552}) combines the 464 enriched records with 88 forward-snowball additions and splits into \textbf {214} KEEP, \textbf {173} DEFER, and \textbf {165} excluded (SKIP, no individually coded reason retained). The valid pool proceeds to full-text queue selection (\textbf {387}), of which \textbf {190} reach data extraction; a separate \textbf {34}-record manual Scopus/WoS cross-validation top-up enters directly at the extraction stage, giving \textbf {224} records extracted in total and yielding the \textbf {123}-paper final reading list (\textbf {120} distinct papers). The \textbf {101} eligibility-stage exclusions are: \textbf {34} manual cross-validation top-up, \textbf {53} background-corpus, and \textbf {14} core-corpus}{figure.caption.9}{}}
