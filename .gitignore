.claude

# ── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
$py.class
*.egg-info/
*.log

# ── Environments & secrets ────────────────────────────────────────────────
.env
.venv
env/
venv/
*.pem
*key*

# ── Editors / OS ──────────────────────────────────────────────────────────
.idea/
.vscode/
.DS_Store
.ipynb_checkpoints

# ── Reference PDFs (kept locally / in Zotero — not in git) ────────────────
**/pdfs/
**/*.pdf

# ── Regenerable / derived artifacts (not source-of-truth) ─────────────────
*.png
# Data-extraction spreadsheets are derived from the pipeline in slr_engine:
# keep them local, not version-controlled here.
*_data_extraction_*.csv

# ── NOTE ──────────────────────────────────────────────────────────────────
# papers_repo/*.csv (G1-G6 curated corpora) ARE tracked — they are the canonical
# literature source. figure PDFs are regenerable (from slr_engine) and stay local.
# The 13_final_reading_list CSV is an audited deliverable (tracked), but the
# superseded S8_ prefixed version is a stale older-generation artifact:
S8_final_reading_list.csv

# ── Large local-only working directories (not needed on GitHub) ───────────
writing/slr_methodology_paper/writing_materials
writing/slr_methodology_paper/validation

# ── LaTeX build artifacts (regenerable — not source-of-truth) ──────────────
# The final PDF (build/out/main.pdf) is already ignored by the repo-level
# **/*.pdf rule; these cover the intermediate files if anyone compiles in place.
*.aux
*.bbl
*.blg
*.fls
*.fdb_latexmk
*.log
*.out
*.toc
*.lot
*.lof
*.nav
*.snm
*.synctex.gz
*.listing
*-converted-to.pdf
*.bcf
*.run.xml
*.ilg
*.ind
*.idx

# Build output directory — the deliverable PDF is already ignored by the
# repo-level **/*.pdf rule; ignore everything else here too.
build/out/*
mdpi_paper/_archive/
_archive/
_prisma_audit/