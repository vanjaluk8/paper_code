.claude

# ── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
$py.class
*.egg-info/
*.log

# ── Environments & secrets ────────────────────────────────────────────────
.env
.venv
env/
venv/
*.pem
*key*

# ── Editors / OS ──────────────────────────────────────────────────────────
.idea/
.vscode/
.DS_Store
.ipynb_checkpoints

# ── Reference PDFs (kept locally / in Zotero — not in git) ────────────────
**/pdfs/
#**/*.pdf

# ── Regenerable / derived artifacts (not source-of-truth) ─────────────────
*.png
# Data-extraction spreadsheets are derived from the pipeline in mdpi_slr_engine:
# keep them local, not version-controlled here.
*_data_extraction_*.csv
# Exception: 11_data_extraction_2026-05-12.csv is the audited 224-row extraction
# deliverable named in the Data Availability statement (main.tex) — it must be
# tracked here, same treatment as 13_final_reading_list_2026-05-12.csv above.
!11_data_extraction_2026-05-12.csv

# ── NOTE ──────────────────────────────────────────────────────────────────
# papers_repo/*.csv (G1-G6 curated corpora) ARE tracked — they are the canonical
# literature source. figure PDFs are regenerable (from mdpi_slr_engine) and stay local.
# The 13_final_reading_list CSV is an audited deliverable (tracked), but the
# superseded S8_ prefixed version is a stale older-generation artifact:
S8_final_reading_list.csv

# ── Large local-only working directories (not needed on GitHub) ───────────
writing/slr_methodology_paper/writing_materials
writing/slr_methodology_paper/validation

# ── LaTeX build artifacts (regenerable — not source-of-truth) ──────────────
# The final PDF (build/out/main.pdf) is already ignored by the repo-level
# **/*.pdf rule; these cover the intermediate files if anyone compiles in place.
*.aux
*.bbl
*.blg
*.fls
*.fdb_latexmk
*.log
*.out
*.toc
*.lot
*.lof
*.nav
*.snm
*.synctex.gz
*.listing
*-converted-to.pdf
*.bcf
*.run.xml
*.ilg
*.ind
*.idx

# Build output directory — the deliverable PDF is already ignored by the
# repo-level **/*.pdf rule; ignore everything else here too.
build/out/*
mdpi_paper/_archive/
_archive/
_prisma_audit/
prisma_audit/
.claude/
CLAUDE.md
materials/

# Raw per-query Scopus/WoS top-up exports (Major #19): large (100MB+),
# vendor-licensed metadata (abstracts, funding details, references).
# Trimmed/merged/shortlisted derivatives (verify/major19_scopus_topup_*.csv,
# verify/db_results/*_trimmed.csv) are tracked instead -- everything
# actually useful (Title/Authors/Year/Source/DOI/Cited-by/EID) is preserved
# there; the dropped columns are regenerable from the DOI if ever needed.
verify/db_results/**/Q*_scopus.csv
verify/db_results/**/Q*_wos.csv
verify/db_results/**/Q*_wos.txt

# ── Local-only review process inputs (not manuscript deliverables) ────────
# The reviewer prompt and the revision instructions derived from it; kept
# locally for reference, not tracked. REVIEWER_REPORT.md is the actual
# review (item IDs D-1/P1-1/E-1/etc. referenced throughout CHANGELOG.md,
# OPEN_QUESTIONS.md, RESPONSE_TO_REVIEWER.md); REVISION_PROMPT.md is the
# instructions that turned it into work packages.
REVIEWER_REPORT.md
REVISION_PROMPT.md
verify/